{
  "name": "sa-event-logistics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "native:sync": "pnpm build && cap sync",
    "ios:altstore": "bash scripts/build-altstore.sh",
